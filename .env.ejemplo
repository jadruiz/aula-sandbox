# Copia este archivo como ".env" (los scripts de arranque lo hacen solos la primera vez).
# Aula empieza en modo offline: no necesita una API key para abrir JupyterLab o LangFlow.
# El archivo .env NUNCA se versiona ni se comparte.
#
# Si una práctica requiere un proveedor, configura después una clave DESECHABLE con
# hard cap externo. No pegues claves en trabajo/, notebooks, Git o chats.

OPENAI_API_KEY=
OPENAI_MODEL_NAME=

# Opcionales — solo si el lab lo pide:
# SERPER_API_KEY=          # búsqueda web en Lab M1 (hay versión sin ella)
# LANGSMITH_API_KEY=       # trazabilidad avanzada en M3
# ANTHROPIC_API_KEY=       # reto final de M4; sólo con autorización y cuota
