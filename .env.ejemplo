# Copia este archivo como ".env" (los scripts de arranque lo hacen solos la primera vez)
# y pega tu clave. El archivo .env NUNCA se versiona ni se comparte.
#
# Usa una clave DESECHABLE creada solo para el curso, con tope de gasto
# configurado en la plataforma (5 USD bastan para los seis labs).

OPENAI_API_KEY=sk-proj-PEGA-AQUI-TU-CLAVE
OPENAI_MODEL_NAME=gpt-4o-mini

